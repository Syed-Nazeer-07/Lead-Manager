{
  "name": "lead-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test server/*.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "pg": "^8.13.3",
    "express-rate-limit": "^8.2.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.1",
    "vite": "^8.0.0"
  }
}
